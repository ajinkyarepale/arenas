// Arenas — live prediction market platform
// Every arena is a fully isolated tenant, keyed by Event.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum Role {
  PARTICIPANT
  ORGANIZER
  SUPERADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PARTICIPANT)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  organizedEvent Event[]            @relation("EventOrganizer")
  participations EventParticipant[]
  trades         Trade[]

  @@index([role])
}

// Standard NextAuth tables (Prisma adapter). Sessions are JWT-based today,
// but these are kept so OAuth providers can be dropped in without a migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Arenas (events)
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  LOBBY
  LIVE
  ENDED
}

model Event {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  description     String?
  hostName        String?
  organizerId     String
  asset           String      @default("BTCUSDT")
  roundDurationSec Int        @default(300)
  lockBufferSec   Int         @default(30)
  totalRounds     Int         @default(12)
  startingBalance Float       @default(1000)
  liquidityParamB Float       @default(40)
  maxStakePerTrade Float      @default(250)
  status          EventStatus @default(DRAFT)
  currentRound    Int         @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime?
  endsAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organizer    User               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  rounds       Round[]
  trades       Trade[]

  @@index([status, scheduledFor])
  @@index([organizerId])
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  balance   Float
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([eventId, userId])
  @@index([eventId, balance])
}

// ---------------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------------

enum RoundStatus {
  PENDING
  TRADING
  LOCKED
  RESOLVED
}

enum Outcome {
  YES
  NO
  VOID
}

model Round {
  id          String      @id @default(cuid())
  eventId     String
  roundNumber Int
  openPrice   Float?
  closePrice  Float?
  outcome     Outcome?
  status      RoundStatus @default(PENDING)

  // Cumulative LMSR state for this round's market.
  qYes Float @default(0)
  qNo  Float @default(0)

  opensAt    DateTime?
  locksAt    DateTime?
  resolvesAt DateTime?
  resolvedAt DateTime?

  voidReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([eventId, roundNumber])
  @@index([eventId, status])
}

enum Side {
  YES
  NO
}

model Trade {
  id            String   @id @default(cuid())
  eventId       String
  roundId       String
  userId        String
  participantId String
  side          Side
  shares        Float
  cost          Float
  priceAtFill   Float
  payout        Float?
  settledAt     DateTime?
  createdAt     DateTime @default(now())

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round       Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([roundId, createdAt])
  @@index([participantId])
  @@index([eventId, userId])
}
