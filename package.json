{
  "name": "arenas",
  "version": "1.0.0",
  "private": true,
  "description": "Arenas — live prediction market platform for college FinTech events",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify:engine": "tsx scripts/verify-engine.ts",
    "icons": "node scripts/generate-icons.mjs",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "^14.2.35",
    "next-auth": "^4.24.10",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.18"
  }
}
