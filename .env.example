# ---- Database ----
# Local docker-compose default. Change for your own Postgres instance.
DATABASE_URL="postgresql://arenas:arenas@localhost:5432/arenas?schema=public"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google sign-in (optional) ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google).
# Leave unset to hide the Google button entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email one-time codes (optional) ----
# Sign up at https://resend.com, verify a domain, and set these to deliver
# real emails. Without RESEND_API_KEY, codes are printed to the server log
# (local development only — never rely on that in production).
RESEND_API_KEY=""
EMAIL_FROM="Arenas <no-reply@arenas.dev>"

# ---- Server ----
PORT=3000
HOSTNAME=0.0.0.0

# Public origin used by the browser to open the Socket.io connection.
# Leave blank to use the same origin the page was served from (recommended).
NEXT_PUBLIC_SOCKET_URL=""

# ---- Price feed ----
BINANCE_REST_BASE="https://api.binance.com"
# Poll interval for the shared price ticker, milliseconds.
PRICE_POLL_INTERVAL_MS=1000

# ---- Round engine ----
# How many samples, and how far apart, for the closing TWAP.
TWAP_SAMPLES=6
TWAP_INTERVAL_MS=1000

# ---- Seed ----
SEED_ORGANIZER_EMAIL="organizer@arenas.dev"
SEED_ORGANIZER_PASSWORD="arenas-demo-2024"
